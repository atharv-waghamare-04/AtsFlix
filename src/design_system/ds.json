{
    "designSystem": {
      "name": "ATSFLIX",
      "version": "1.0.0",
      "theme": "dark",
      "description": "A cinematic streaming platform design system inspired by premium OTT experiences.",
  
      "brand": {
        "name": "ATSFLIX",
        "personality": [
          "Cinematic",
          "Premium",
          "Immersive",
          "Bold",
          "Minimal"
        ],
        "logo": {
          "primaryColor": "#E50914",
          "usage": "Use on dark backgrounds only",
          "minimumSpacing": "16px"
        }
      },
  
      "colors": {
        "brand": {
          "primary": {
            "name": "ATS Red",
            "value": "#E50914"
          },
          "hover": {
            "name": "ATS Red Hover",
            "value": "#B20710"
          },
          "dark": {
            "name": "ATS Dark Red",
            "value": "#831010"
          }
        },
  
        "background": {
          "black": "#000000",
          "dark": "#141414",
          "card": "#181818",
          "surface": "#222222",
          "hover": "#2F2F2F"
        },
  
        "text": {
          "primary": "#FFFFFF",
          "secondary": "#B3B3B3",
          "muted": "#808080",
          "disabled": "#666666"
        },
  
        "actions": {
          "success": "#46D369",
          "danger": "#E50914",
          "warning": "#F5C518"
        },
  
        "overlay": {
          "light": "rgba(255,255,255,0.12)",
          "medium": "rgba(255,255,255,0.08)",
          "dark": "rgba(0,0,0,0.70)"
        },
  
        "gradient": {
          "heroBottom": "linear-gradient(to top,#141414,transparent)",
          "heroLeft": "linear-gradient(to right,#000000 0%,transparent 70%)",
          "navbar": "linear-gradient(to bottom,#000000,transparent)"
        }
      },
  
      "typography": {
        "fontFamily": {
          "primary": "Inter",
          "fallback": [
            "Arial",
            "Helvetica",
            "sans-serif"
          ]
        },
  
        "fontWeights": {
          "regular": 400,
          "medium": 500,
          "semiBold": 600,
          "bold": 700,
          "extraBold": 800
        },
  
        "scale": {
          "heroTitle": {
            "size": "56px",
            "lineHeight": "1.2",
            "weight": 800
          },
          "pageTitle": {
            "size": "32px",
            "lineHeight": "1.3",
            "weight": 700
          },
          "sectionTitle": {
            "size": "28px",
            "lineHeight": "1.3",
            "weight": 700
          },
          "cardTitle": {
            "size": "18px",
            "lineHeight": "1.4",
            "weight": 600
          },
          "body": {
            "size": "16px",
            "lineHeight": "1.5",
            "weight": 400
          },
          "metadata": {
            "size": "14px",
            "lineHeight": "1.5",
            "weight": 400
          },
          "caption": {
            "size": "12px",
            "lineHeight": "1.4",
            "weight": 400
          }
        }
      },
  
      "spacing": {
        "baseUnit": "4px",
        "scale": {
          "xs": "4px",
          "sm": "8px",
          "md": "16px",
          "lg": "24px",
          "xl": "32px",
          "2xl": "48px",
          "3xl": "64px"
        }
      },
  
      "borderRadius": {
        "small": "4px",
        "medium": "8px",
        "large": "12px",
        "pill": "999px"
      },
  
      "shadows": {
        "card": "0 8px 20px rgba(0,0,0,0.4)",
        "modal": "0 20px 50px rgba(0,0,0,0.6)",
        "hover": "0 10px 30px rgba(0,0,0,0.5)"
      },
  
      "buttons": {
        "primary": {
          "background": "#E50914",
          "hover": "#B20710",
          "text": "#FFFFFF",
          "padding": "12px 24px",
          "radius": "4px",
          "fontWeight": 700
        },
  
        "secondary": {
          "background": "rgba(109,109,109,0.7)",
          "hover": "rgba(109,109,109,0.5)",
          "text": "#FFFFFF",
          "padding": "12px 24px",
          "radius": "4px",
          "fontWeight": 600
        }
      },
  
      "icons": {
        "style": "minimal-outline",
        "sizes": {
          "small": "16px",
          "medium": "24px",
          "large": "32px"
        },
        "icons": [
          "play",
          "search",
          "add",
          "check",
          "info",
          "bell",
          "profile",
          "settings"
        ]
      },
  
      "components": {
  
        "navbar": {
          "height": "72px",
          "background": "transparent",
          "scrollBackground": "#141414",
          "logoWidth": "120px",
          "itemsSpacing": "24px"
        },
  
        "hero": {
          "height": "85vh",
          "overlay": [
            "heroLeft",
            "heroBottom"
          ],
          "titleSize": "56px",
          "descriptionWidth": "500px",
          "actions": [
            "playButton",
            "moreInfoButton"
          ]
        },
  
        "movieCard": {
          "aspectRatio": "2/3",
          "borderRadius": "8px",
          "background": "#181818",
          "hover": {
            "scale": "1.05",
            "duration": "300ms",
            "shadow": true
          }
        },
  
        "landscapeCard": {
          "aspectRatio": "16/9",
          "borderRadius": "8px"
        },
  
        "modal": {
          "background": "#181818",
          "radius": "12px",
          "overlay": "rgba(0,0,0,0.7)"
        }
      },
  
      "layout": {
        "container": {
          "maxWidth": "1280px",
          "padding": "48px"
        },
  
        "grid": {
          "desktop": {
            "columns": 6,
            "gap": "24px"
          },
          "tablet": {
            "columns": 4,
            "gap": "16px"
          },
          "mobile": {
            "columns": 2,
            "gap": "12px"
          }
        }
      },
  
      "animation": {
        "duration": {
          "fast": "150ms",
          "normal": "300ms",
          "slow": "500ms"
        },
  
        "easing": {
          "default": "ease-in-out"
        },
  
        "transitions": {
          "cardHover": {
            "transform": "scale(1.05)",
            "duration": "300ms"
          },
  
          "fade": {
            "opacity": "0 → 1",
            "duration": "300ms"
          }
        }
      },
  
      "moviePlatformRules": {
        "hero": {
          "priority": "Highest",
          "contentFocus": true
        },
  
        "poster": {
          "preferredRatio": "2:3"
        },
  
        "carousel": {
          "visibleDesktop": 6,
          "visibleTablet": 4,
          "visibleMobile": 2,
          "gap": "24px"
        },
  
        "contentHierarchy": [
          "Hero Featured Movie",
          "Trending Now",
          "Popular Movies",
          "Continue Watching",
          "Recommended For You",
          "Genres"
        ]
      }
    }
  }